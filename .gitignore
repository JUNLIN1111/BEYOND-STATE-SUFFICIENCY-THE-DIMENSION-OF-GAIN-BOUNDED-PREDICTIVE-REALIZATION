# Python / local runtime
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store

# Virtual environments and local configs
.venv/
venv/
env/
*.env
.env*
*:

# Nested repositories / local histories
# Keep the source files, but do not upload embedded git histories when packaging
# this directory as a new GitHub repository.
**/.git/

# Demos are intentionally kept outside the public upload.
demo/
demos/
Demo/
Demos/
*_demo/
*demo_output*/

# Demo/video artifacts
*.mp4
*.mov
*.avi
*.mkv
*.webm

# Model checkpoints and learned binary artifacts
*.pt
*.pth
*.ckpt
*.safetensors
*.npz
*.npy
*.h5
*.hdf5

# Large generated experiment directories
le-wm/outputs/
maze/maze1/outputs/runs/
controlled_system/Toy/experiments/

# Local logs / tracking
wandb/
mlruns/
logs/
*.log

# Keep lightweight paper-facing artifacts, summaries, and figures trackable.
